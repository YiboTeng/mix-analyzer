{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mix-analyzer.local/schemas/diagnosis-evidence.schema.json",
  "title": "Mix Analyzer Diagnosis Evidence",
  "type": "object",
  "required": ["schema_version", "analysis_mode", "context", "findings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plugin_id": {"type": "string"},
    "analyzer_version": {"type": "string"},
    "analysis_mode": {"enum": ["vocal-reference", "mix-reference", "manual"]},
    "source": {"type": "object"},
    "context": {
      "type": "object",
      "properties": {
        "reference_count": {"type": ["integer", "null"], "minimum": 0},
        "reference_gate": {
          "type": ["object", "null"],
          "properties": {
            "passed": {"type": "boolean"},
            "reasons": {"type": "array", "items": {"type": "string"}},
            "reference_count": {"type": "integer", "minimum": 0},
            "duplicate_references": {"type": "array"},
            "median_compatibility": {"type": ["number", "null"]},
            "severe_outliers": {"type": "array"},
            "limitations": {"type": "array", "items": {"type": "string"}},
            "source_separated_reference_count": {"type": "integer", "minimum": 0},
            "confidence_cap": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "additionalProperties": false
        },
        "automatic_thresholds_calibrated": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["diagnosis_id", "direction", "severity", "confidence", "scope", "evidence"],
        "properties": {
          "diagnosis_id": {"type": "string", "minLength": 1},
          "direction": {"type": "string", "minLength": 1},
          "severity": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence_basis": {"type": "string"},
          "severity_basis": {"type": "string"},
          "scope": {"type": "string", "minLength": 1},
          "calibration_required": {"type": "boolean"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [{
    "if": {"properties": {"analysis_mode": {"enum": ["vocal-reference", "mix-reference"]}}},
    "then": {
      "properties": {
        "context": {
          "required": ["reference_gate"],
          "properties": {
            "reference_gate": {"type": "object", "required": ["passed", "reasons"]}
          }
        }
      }
    }
  }]
}
