{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mix-analyzer.local/schemas/p1-supplemental-profile.schema.json",
  "title": "Mix Analyzer P1 L2 Supplemental Profile",
  "type": "object",
  "required": ["schema_version", "adapter_id", "family_id", "identity", "capabilities", "routing", "parameter_strategy", "input_requirements", "risks", "stop_conditions", "version_policy", "evidence", "p0_contract", "validation", "catalog_warnings", "local_guidance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "adapter_id": {"type": "string", "pattern": "^l2-[a-f0-9]{12}--[a-z0-9-]+$"},
    "family_id": {"type": "string", "pattern": "^[a-f0-9]{12}$"},
    "identity": {
      "type": "object",
      "required": ["vendor", "product", "version_range", "formats", "availability", "tested_host"]
    },
    "capabilities": {
      "type": "object",
      "required": ["primary", "secondary", "diagnoses", "not_for"]
    },
    "routing": {"type": "array", "minItems": 1},
    "parameter_strategy": {
      "type": "object",
      "required": ["targets", "controls", "no_universal_values"]
    },
    "input_requirements": {"type": "array", "minItems": 1},
    "risks": {"type": "array", "minItems": 1},
    "stop_conditions": {"type": "array", "minItems": 1},
    "alternatives": {"type": "array"},
    "version_policy": {"type": "object", "required": ["match", "mismatch"]},
    "evidence": {
      "type": "object",
      "required": ["level", "packaged"],
      "properties": {
        "level": {"const": "L2"},
        "packaged": {
          "type": "object",
          "required": ["card", "source_note"],
          "properties": {
            "card": {"$ref": "#/$defs/evidenceFile"},
            "source_note": {"$ref": "#/$defs/evidenceFile"}
          }
        }
      }
    },
    "p0_contract": {"type": "object", "required": ["diagnosis_inputs", "outputs"]},
    "conflict_rules": {"type": "array"},
    "validation": {
      "type": "object",
      "required": ["status", "matrix_status", "boundary"],
      "properties": {
        "status": {"const": "deferred-l2"},
        "matrix_status": {"const": "not-l3"},
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "catalog_warnings": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "local_guidance": {
      "type": "object",
      "required": ["signal_position", "routing", "controls", "parameter_start_points", "listen_for", "stop", "latency"]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "evidenceFile": {
      "type": "object",
      "required": ["packaged_path", "sha256"],
      "properties": {
        "packaged_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
