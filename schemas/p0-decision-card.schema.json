{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mix-analyzer.local/schemas/p0-decision-card.schema.json",
  "title": "P0 Decision Card Set",
  "type": "object",
  "required": ["schema_version", "cards"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "diagnoses", "modes", "scopes", "chain_stage", "action", "verification", "provenance"],
        "properties": {
          "id": {"type": "string", "pattern": "^p0-[a-z0-9-]+$"},
          "title": {"type": "string"},
          "diagnoses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "modes": {"type": "array", "minItems": 1, "items": {"enum": ["vocal-reference", "mix-reference", "manual"]}},
          "scopes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "requires_stems": {"type": "boolean"},
          "chain_stage": {"type": "string"},
          "preferred_capabilities": {"type": "array", "items": {"type": "string"}},
          "capability_by_diagnosis": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
          "evidence_weight": {"type": "number", "minimum": 0, "maximum": 1},
          "calibration_required": {"type": "boolean"},
          "hypotheses": {"type": "array", "items": {"type": "string"}},
          "disambiguation_tests": {"type": "array", "items": {"type": "string"}},
          "action": {
            "type": "object",
            "required": ["routing", "steps", "parameter_start_ranges"],
            "properties": {
              "routing": {"type": "string", "minLength": 1},
              "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "parameter_start_ranges": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "verification": {
            "type": "object",
            "required": ["listen_for", "failure_signs", "stop_conditions", "remeasure_metrics"],
            "properties": {
              "listen_for": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "failure_signs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "remeasure_metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "required": ["evidence_grade", "source_paths"],
            "properties": {
              "evidence_grade": {"type": "string"},
              "source_paths": {"type": "array", "items": {"type": "string"}},
              "official_urls": {"type": "array", "items": {"type": "string", "format": "uri"}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
