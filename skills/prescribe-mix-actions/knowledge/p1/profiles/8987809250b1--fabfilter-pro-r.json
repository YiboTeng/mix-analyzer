      {
        "name": "Space / Decay Rate",
        "meaning": "连续房间模型/基准尾长与整体倍率。",
        "action": "先选空间形态，再把尾长贴合节奏。"
      },
      {
        "name": "Distance",
        "meaning": "改变靠近/远离声源的早反射与建立。",
        "action": "主唱保持较近，背景层再拉远。"
      },
      {
        "name": "Brightness / Character",
        "meaning": "高低频/高频衰减与从透明到调制/反射性格。",
        "action": "从中性开始，小步加入角色。"
      },
      {
        "name": "Decay Rate EQ",
        "meaning": "按频率缩短/延长尾长。",
        "action": "缩短低中频和齿音尾，而非只用 Post EQ。"
      },
      {
        "name": "Post EQ / Width / Predelay",
        "meaning": "最终湿声频响、宽度和起始间隔。",
        "action": "Aux 低切/低通，Width/Predelay 用 Mono/咬字检查。"
      }
    ],
    "parameter_start_points": [
      "Space 对应 0.6–1.5 s、Predelay 20–60 ms、Distance 近中。",
      "Decay Rate EQ：低频 50–80%、高频 50–80% 起。",
      "Post EQ 高通 120–250 Hz、低通 6–12 kHz。"
    ],
    "listen_for": [
      "Decay Rate 与 Post EQ误用。",
      "Character 过高造成 Echo/Chorus。",
      "低中频尾堆积。"
    ],
    "stop": [
      "空间在上下文成立且每个频段尾长有理由。",
