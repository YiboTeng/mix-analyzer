    "routing": [
      "单轨 Insert 前段；在 Vocal Rider/MV2 等会抬高低电平的工具之前。",
      "严重、变化快或音乐性噪声改用 RX/Spectral 工具。"
    ],
    "controls": [
      {
        "name": "Suppression Fader",
        "meaning": "决定自动噪声抑制量。",
        "action": "从 0 慢慢上推，刚好让噪声退到编曲下方，不追求独听绝对静音。"
      },
      {
        "name": "Attenuation Meter",
        "meaning": "显示被移除的总体能量。",
        "action": "观察强弱音节是否持续触发过深衰减，并结合听感回退。"
      }
    ],
    "parameter_start_points": [
      "Fader 从 0 上推，不给固定万能数值；以噪声刚退到伴奏下、语尾仍自然为起点。",
      "若独唱检查出现水声/门控，退回一档并让编曲遮蔽剩余噪声。"
    ],
    "listen_for": [
      "词尾、气息和低电平辅音是否出现水声或开合。",
      "高频是否变空、立体声噪声是否造成声像漂移。"
    ],
    "stop": [
      "在完整编曲中噪声不再分散注意力时停止。",
      "继续上推只改善独唱静音、却伤害语尾和气息时回退。"
