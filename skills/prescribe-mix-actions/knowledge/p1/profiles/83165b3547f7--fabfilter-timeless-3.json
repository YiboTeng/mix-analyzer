  "local_guidance": {
    "signal_position": [
      "100% Wet Aux并Lock Mix；先基础Delay/Feedback/Filter，再加Tap/Mod/FX。",
      "Ducking用主输入Envelope Follower负向调Wet Level。"
    ],
    "routing": [
      "Stereo Aux 100% Wet并Lock Mix。",
      "自动化Send、Freeze、Feedback或Tap电平。"
    ],
    "controls": [
      {
        "name": "Delay/Sync/Read Mode",
        "meaning": "基础时间、节拍与Tape变调或Stretch保音高。",
        "action": "常规Sync；自动化时间时按想要Pitch Glide与否选。"
      },
      {
        "name": "Feedback/Cross/PingPong",
        "meaning": "同通道/跨通道反馈和反弹。",
        "action": "20–40%起，>100只短自动化。"
      },
      {
        "name": "Taps",
        "meaning": "最多15附加Tap+主Tap的时间/电平/声像。",
        "action": "先2–4 Tap按节奏空隙排，不铺满。"
      },
      {
        "name": "Filters",
        "meaning": "重复每轮进一步滤波。",
        "action": "HP/LP置反馈路径，逐次变暗/变薄。"
      },
      {
        "name": "EF→Wet Level / FX",
        "meaning": "输入包络Duck湿声及Drive/LoFi/Diffuse/Pitch。",
        "action": "先搭Duck，再一次加一个FX。"
      }
    ],
    "parameter_start_points": [
      "1/8D或1/4、Feedback20–35%、2–4 Tap、HP180–300Hz、LP5–9kHz。",
      "EF负向调Wet Level，主唱发声时退3–8dB。",
      "Auto Mute Self-Osc On。"
    ],
    "listen_for": [
      "自激、Pitch递增失控、Filter共振。",
      "Tap过密像混响并遮词。",
      "M/S/跨反馈Mono相消。"
    ],
    "stop": [
      "每个Tap/FX有明确作用。",
      "关闭任何层无差异就删除。"
    ],
    "latency": [
      "Pitch开启会把最短Delay从5提高到45ms；官方未列PDC/OS。S4测各FX、ReadMode和PDC。"
    ]
  }
